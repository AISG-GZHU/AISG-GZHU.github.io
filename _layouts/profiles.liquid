---
layout: page
---
<style>
  .member-list {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .member-profile {
    align-items: center;
    border-bottom: 1px solid var(--global-divider-color);
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 145px minmax(0, 1fr);
    padding: 1.1rem 0;
  }

  .member-profile:first-child {
    padding-top: 0;
  }

  .member-photo {
    height: 132px;
    justify-self: center;
    width: 132px;
  }

  .member-photo figure,
  .member-photo picture {
    display: block;
    height: 100%;
    margin: 0;
    overflow: hidden;
    width: 100%;
  }

  .member-photo img {
    background: #f6f8fa;
    display: block;
    height: 100% !important;
    object-fit: cover;
    object-position: center center;
    width: 100% !important;
  }

  .member-details {
    min-width: 0;
  }

  .member-info {
    color: var(--global-text-color);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 0.55rem;
  }

  .member-info p {
    display: block;
    margin: 0.08rem 0;
  }

  .member-info p:first-child {
    color: var(--global-text-color);
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .member-bio {
    color: var(--global-text-color);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .member-bio p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 575.98px) {
    .member-profile {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      text-align: center;
    }

    .member-photo {
      height: 118px;
      width: 118px;
    }

    .member-info,
    .member-bio {
      text-align: left;
    }
  }
</style>

<div class="post">
  <article>
    {% if page.profiles %}
      <div class="member-list">
        {% for profile in page.profiles %}
          <section class="member-profile">
            <div class="member-photo">
              {% if profile.image %}
                {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                {% if profile.image_circular %}
                  {% assign profile_image_class = 'z-depth-1 rounded-circle' %}
                {% else %}
                  {% assign profile_image_class = 'z-depth-1 rounded' %}
                {% endif %}
                {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes="132px" alt=profile.image %}
              {% endif %}
            </div>

            <div class="member-details">
              {% if profile.more_info %}
                <div class="member-info">{{ profile.more_info }}</div>
              {% endif %}

              <div class="member-bio">
                {% if profile.content %}
                  {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                  {{ profile_content | markdownify }}
                {% else %}
                  {{ content }}
                {% endif %}
              </div>
            </div>
          </section>
        {% endfor %}
      </div>
    {% endif %}
  </article>
</div>
