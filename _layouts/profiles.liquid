---
layout: page
---
<style>
  .member-profile-entry {
    clear: both;
    overflow: hidden;
  }

  .member-profile-entry hr {
    margin: 1.35rem 0;
  }

  .member-profile-entry .profile {
    width: 220px;
    max-width: 34%;
    text-align: center;
  }

  .member-profile-entry .profile figure {
    height: 180px;
    margin: 0 auto 0.65rem;
    overflow: hidden;
    width: 180px;
  }

  .member-profile-entry .profile picture {
    display: block;
    height: 100%;
    width: 100%;
  }

  .member-profile-entry .profile img {
    background: #f6f8fa;
    display: block;
    height: 100% !important;
    object-fit: cover;
    object-position: center center;
    width: 100% !important;
  }

  .member-profile-entry .profile .more-info {
    font-family: inherit;
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: 0.25rem;
    text-align: left;
  }

  .member-profile-entry .profile .more-info p {
    display: block;
    margin: 0.12rem 0;
  }

  .member-profile-entry .profile .more-info p:first-child {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    text-align: center;
  }

  .member-profile-entry .clearfix {
    font-size: 0.95rem;
    line-height: 1.75;
    min-height: 210px;
  }

  @media (max-width: 575.98px) {
    .member-profile-entry {
      overflow: visible;
    }

    .member-profile-entry .profile {
      float: none !important;
      margin: 0 auto 1rem !important;
      max-width: 100%;
      width: 100%;
    }

    .member-profile-entry .profile figure {
      height: 150px;
      width: 150px;
    }

    .member-profile-entry .profile .more-info {
      text-align: center;
    }

    .member-profile-entry .clearfix {
      min-height: 0;
    }
  }
</style>

<div class="post">
  <article>
    {% if page.profiles %}
      {% for profile in page.profiles %}
        <div class="member-profile-entry">
          <hr>
          <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
            {% if profile.image %}
              {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
              {% if profile.image_circular %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
              {% endif %}
              {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes="180px" alt=profile.image %}
            {% endif %}
            {% if profile.more_info %}
              <div class="more-info">{{ profile.more_info }}</div>
            {% endif %}
          </div>

          <div class="clearfix">
            {% if profile.content %}
              {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
              {{ profile_content | markdownify }}
            {% else %}
              {{ content }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </article>
</div>
